# ─────────────────────────────────────────────────────────────
# Ofelia Vallejo · Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Admin ─────────────────────────────────────────────────────
# REQUIRED in production
ADMIN_PASSWORD=
# REQUIRED in production — JWT signing secret (different from password)
ADMIN_SECRET=

# ── Database ──────────────────────────────────────────────────
# REQUIRED in production — PostgreSQL connection string
DATABASE_URL=postgres://user:pass@host:5432/ofelia
# OPTIONAL — Vercel Blob token (image uploads + catalog fallback)
BLOB_READ_WRITE_TOKEN=
# DEV ONLY — set to "file" to use data/catalog.json instead of Postgres
STORE_MODE=file

# ── Stripe ────────────────────────────────────────────────────
# REQUIRED in production
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# REQUIRED — production domain for redirect URLs
SITE_URL=https://ofeliavallejo.com

# ── Email (SMTP) ──────────────────────────────────────────────
# OPTIONAL — if not set, emails are logged in dev mode only
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Destination for contact + personalización requests
EMAIL_TO=atelierofelia.vallejo@gmail.com

# ── Launch popup ──────────────────────────────────────────────
# OPTIONAL — default values used if not set
LAUNCH_COUPON_CODE=OV-TEMPORADA
LAUNCH_DISCOUNT_LABEL=10% en tu primera pieza · lanzamiento de temporada

# ── Customer accounts + WhatsApp ──────────────────────────────
# OPTIONAL — JWT secret for customer sessions (defaults to ADMIN_SECRET)
CUSTOMER_SECRET=
# OPTIONAL — WhatsApp number (digits only, with country code)
WHATSAPP_NUMBER=573005526208
