{
  "installCommand": "npm install --omit=dev",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "cleanUrls": true,
  "rewrites": [
    { "source": "/producto/:slug", "destination": "/producto/index.html?slug=:slug" }
  ],
  "redirects": [
    { "source": "/coleccion.html", "destination": "/coleccion", "permanent": true },
    { "source": "/home.html", "destination": "/home", "permanent": true },
    { "source": "/producto/travel-bag-i.html", "destination": "/producto/travel-bag-i", "permanent": true },
    { "source": "/producto/travel-bag-ii.html", "destination": "/producto/travel-bag-ii", "permanent": true },
    { "source": "/producto/travel-bag-iii.html", "destination": "/producto/travel-bag-iii", "permanent": true },
    { "source": "/producto/bolso-dama.html", "destination": "/producto/bolso-dama", "permanent": true },
    { "source": "/producto/morral-elite.html", "destination": "/producto/morral-elite", "permanent": true },
    { "source": "/producto/maletin.html", "destination": "/producto/travel-bag-ii", "permanent": true },
    {
      "source": "/assets/img/logo_tarjetas_sello.png",
      "destination": "/assets/img/logo_sello.png",
      "permanent": true
    },
    {
      "source": "/assets/img/logo-firma.png",
      "destination": "/assets/img/logo_firma_completa.png",
      "permanent": true
    },
    {
      "source": "/assets/img/nuevas/:path*",
      "destination": "/imagenes nuevas/:path*",
      "permanent": true
    },
    {
      "source": "/assets/img/inicio/:file",
      "destination": "/imagenes nuevas/inicio/:file",
      "permanent": true
    },
    {
      "source": "/assets/img/producto/:path*",
      "destination": "/imagenes nuevas/producto/:path*",
      "permanent": true
    },
    {
      "source": "/assets/img/lifestyle/:path*",
      "destination": "/imagenes nuevas/:path*",
      "permanent": true
    },
    {
      "source": "/assets/img/cuero/:file",
      "destination": "/imagenes nuevas/lifestyle/mujer/tote-cognac-lifestyle.jpg",
      "permanent": true
    },
    {
      "source": "/producto/maletin",
      "destination": "/producto/travel-bag-ii",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(home|coleccion|personalizar|manifiesto|cuero|contacto|checkout|cuenta|gracias|admin)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/assets/video/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
